# Local-only settings. Copy this file to .env before starting Airflow.

# Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local
AIRFLOW_ADMIN_FIRSTNAME=Local
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.local
AIRFLOW__CORE__FERNET_KEY=

# PostgreSQL metadata database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow-local
POSTGRES_DB=airflow

# Databricks Free Edition workspace
# Use the workspace URL, for example https://dbc-xxxx.cloud.databricks.com
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-replace-me

# Unity Catalog smoke-test target
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_VOLUME=nyc_taxi_landing

# Optional Databricks SQL warehouse smoke-test target.
# Leave blank to skip the warehouse check.
DATABRICKS_WAREHOUSE_ID=

# Compose image name
AIRFLOW_IMAGE_NAME=nyc-airflow:local


